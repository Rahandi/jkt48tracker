# ── Artifact Registry ──────────────────────────────────────────────────────────
# Filled in automatically by the CI/CD pipeline on each deploy.
# Set manually for the first run or to pin a specific image version.
GAR_REGISTRY=asia-southeast1-docker.pkg.dev/YOUR_GCP_PROJECT_ID/jkt48tracker
IMAGE_TAG=latest

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_NAME=jkt48tracker
DATABASE_USER=jkt48tracker
DATABASE_PASS=change_me_strong_password
DATABASE_ROOT_PASS=change_me_root_password

# ── Application ────────────────────────────────────────────────────────────────
INTERNAL_API_KEY=change_me_long_random_string

# ── Caddy reverse proxy ────────────────────────────────────────────────────────
# ":80"          → HTTP only (default, good for testing)
# "example.com"  → Caddy fetches a Let's Encrypt certificate automatically
DOMAIN=:80
