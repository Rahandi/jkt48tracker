FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir requests python-dotenv tweepy Pillow

COPY tweet_shows.py tweet_daily_stats.py ./

ENV PYTHONUNBUFFERED=1
